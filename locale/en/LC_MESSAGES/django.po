msgstr "Project-Id-Version: WireGuardian\nContent-Type: text/plain; charset=UTF-8\nLanguage: en\nPlural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "\nHTTPS : un certificat local sera créé. Importez-le comme certificat de confiance\nou remplacez-le par un certificat de votre PKI. Aucun port HTTP public nécessaire."
msgstr "\nHTTPS: a local certificate will be created. Import it as a trusted certificate\nor replace it with a certificate from your PKI. No public HTTP port is needed."

msgid "\nInstallation des dépendances, création des services, HTTPS privé et pare-feu.\nLes entrées non autorisées et le transfert hors VPN seront bloqués.\nAucune modification de l’adresse IP du serveur ni de la configuration SSH.\nAucun redémarrage automatique. L’inscription 2FA sera facultative dans la dashboard."
msgstr "\nDependencies, services, private HTTPS and a firewall will be installed.\nUnauthorized inbound connections and forwarding outside the VPN policy will be blocked.\nThe server’s IP address and SSH configuration will not be changed.\nNo automatic reboot. 2FA enrolment will be optional in the dashboard."

msgid "\nInstallation terminée : https://{value0}\nImportez /etc/keyboarded/tls.crt sur vos postes d’administration.\nRedirigez uniquement UDP {value1} sur votre routeur.\nVérifiez un redémarrage et un client VPN avant mise en service.\n"
msgstr "\nInstallation complete: https://{value0}\nImport /etc/keyboarded/tls.crt on your administration devices.\nForward only UDP {value1} on your router.\nTest a reboot and a VPN client before going live.\n"

